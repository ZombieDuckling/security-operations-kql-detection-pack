// High-volume file downloads from SharePoint/OneDrive.
OfficeActivity
| where TimeGenerated > ago(6h)
| where Workload in ("SharePoint", "OneDrive")
| where Operation in ("FileDownloaded", "FileSyncDownloadedFull")
| summarize DownloadCount=count(), Files=make_set(SourceFileName, 20), Sites=make_set(Site_Url, 10) by UserId, ClientIP, bin(TimeGenerated, 1h)
| where DownloadCount > 100
| project TimeGenerated, UserId, ClientIP, DownloadCount, Sites, Files
